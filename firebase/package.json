{
  "name": "docease-firebase-rules-tests",
  "private": true,
  "description": "Firestore and Storage security rules for DOCEase, with emulator tests. Separate from the Flutter app so pubspec stays untouched.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project demo-docease \"node --test --test-concurrency=1 test/*.test.js\"",
    "test:run": "node --test --test-concurrency=1 test/*.test.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.1"
  }
}
