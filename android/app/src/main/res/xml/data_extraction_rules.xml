<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep patient databases and key material out of cloud backup
     and device-to-device transfer. The SQLCipher keys live in the Android
     Keystore and do not transfer, so a restored database could never be
     opened anyway (it would surface as keyMismatch). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
